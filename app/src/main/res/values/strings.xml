    <string name="accessibility_service_description">Blockfy uses Accessibility Service solely to detect and exit short-form video feeds (Reels &amp; Shorts).</string>
    <string name="accessibility_service">Accessibility Service</string>
    <string name="accessibility_active">Active. Tap to view settings.</string>
    <string name="accessibility_inactive">Not granted. Tap here to enable.</string>

    <string name="accessibility_dialog_title">How to Activate Blockfy</string>
    <string name="accessibility_dialog_desc">Blockfy needs the Accessibility Service strictly to detect Reels/Shorts and bring you back to the home feed. No data is collected and the app operates 100% offline.</string>

    <string name="play_protect_title">1. Google Play Protect</string>
    <string name="play_protect_desc">If Google Play Protect warns you when installing the APK, tap \"More details\" and then \"Install anyway\".</string>

    <string name="samsung_title">2. Samsung, Motorola &amp; Android 13+</string>
    <string name="samsung_desc">If the accessibility switch is greyed out with a \"Restricted setting\" prompt:\n\n1. Tap the \"1. Open App Info\" button below;\n2. Tap the 3 dots (⋮) in the top-right corner;\n3. Select \"Allow restricted settings\" and confirm with your PIN/fingerprint;\n4. Return and tap \"2. Open Accessibility\" to turn on Blockfy.</string>

    <string name="xiaomi_title">3. Xiaomi / HyperOS / MIUI</string>
    <string name="xiaomi_desc">• In App Info, enable \"Autostart\".\n• When toggling Accessibility, wait for Xiaomi\'s 10-second security countdown and tap OK.</string>

    <string name="btn_open_app_info">1. Open App Info (3 dots ⋮)</string>
    <string name="btn_open_accessibility">2. Open Accessibility Settings</string>
