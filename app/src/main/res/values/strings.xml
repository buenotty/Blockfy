    <string name="usage_access_title">Usage Access</string>
    <string name="usage_access_active">Active. StayFree-style monitoring — banks are never observed.</string>
    <string name="usage_access_inactive">Not granted. Tap here to enable.</string>

    <string name="usage_access_dialog_title">How to Activate Blockfy</string>
    <string name="usage_access_dialog_desc" formatted="false">Usage Access counts time in social apps, the same API StayFree uses. It never observes Nubank or other banks.</string>

    <string name="accessibility_service_description">Blockfy uses Accessibility only to detect Reels and Shorts inside Instagram, YouTube, TikTok, Facebook and X. Banking apps are outside this list and are never read.</string>
    <string name="accessibility_service">Accessibility (Reels / Shorts)</string>
    <string name="accessibility_active">Active. Sandboxed to social apps — banks are never observed.</string>
    <string name="accessibility_inactive">Not granted. Required to leave Reels and keep the feed.</string>
    <string name="accessibility_dialog_title">How to Activate Reels Blocking</string>
    <string name="accessibility_dialog_desc" formatted="false">Accessibility is locked to Instagram, YouTube, TikTok, Facebook and X. It cannot receive events from Nubank or other banks, does not draw overlays, and does not install APKs.</string>

    <string name="play_protect_title">1. Google Play Protect</string>
    <string name="play_protect_desc">If Google Play Protect warns you when installing the APK, tap \"More details\" and then \"Install anyway\".</string>

    <string name="samsung_title">2. Samsung, Motorola &amp; Android 13+</string>
    <string name="samsung_desc">If Usage Access is missing or greyed out:\n\n1. Tap \"1. Open App Info\" below;\n2. Tap the 3 dots (⋮) in the top-right corner;\n3. Select \"Allow restricted settings\" if shown;\n4. Return and tap \"2. Open Usage Access\" to enable Blockfy.</string>

    <string name="xiaomi_title">3. Xiaomi / HyperOS / MIUI</string>
    <string name="xiaomi_desc">• In App Info, enable \"Autostart\".\n• In Other permissions, allow usage access and background pop-ups if asked.</string>

