                android:startY="6"
                android:endX="84"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#4F46E5"/>
                <item android:offset="0.5" android:color="#6366F1"/>
                <item android:offset="1.0" android:color="#7C3AED"/>
            </gradient>
        </aapt:attr>
