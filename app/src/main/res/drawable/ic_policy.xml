    <!-- Bottom Cutout -->
    <path
        android:pathData="M41,47 L47,47 C50.5,47 53.5,49 53.5,52.5 C53.5,56 50.5,58 47,58 L41,58 Z"
        android:fillColor="#6841E3"/>

    <!-- Dynamic Focus Dot / Indicator -->
    <path
        android:pathData="M70,32 A4,4 0 1,1 62,32 A4,4 0 1,1 70,32 Z"
        android:fillColor="#38BDF8"/>
</vector>
